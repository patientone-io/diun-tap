# ==============================================================================
# DiunTap Configuration
# ==============================================================================

# Telegram Bot Credentials (Required)
# 1. Create a bot via @BotFather to get your token.
# 2. Get your numeric chat ID via @userinfobot.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Telegram allow-list (Optional, recommended)
# Comma-separated Telegram user IDs allowed to tap buttons. Only from_user.id
# is verified. When empty, falls back to TELEGRAM_CHAT_ID (single-user mode).
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# DIUN webhook shared secret (Optional, recommended)
# When set, /webhook/diun requires header X-Diun-Secret or ?token= with this
# value (constant-time comparison). When empty, the webhook runs in legacy
# unauthenticated mode and logs a WARNING (smooth migration for existing setups).
# DIUN_WEBHOOK_SECRET=change-me-to-a-long-random-string
DIUN_WEBHOOK_SECRET=

# GitHub Token (Optional, recommended)
# Increases GitHub API rate limit from 60 to 5,000 requests/hour to fetch changelogs.
# Create a fine-grained or classic personal access token (no special scopes needed).
GITHUB_TOKEN=

# Language / Localization (Optional: 'en' or 'pl', default: 'en')
LANGUAGE=en

# Webhook Server Port (Default: 5000)
WEBHOOK_PORT=5000

# Local Node Configuration
LOCAL_NODE_NAME=Local
# Host path where your Compose stacks are stored:
DOCKER_STACKS_DIR=/srv/docker
# Host docker socket group id (see: stat -c %g /var/run/docker.sock).
# Used as group_add in compose.yaml so the non-root diuntap user keeps access.
# Common values: 999 (Debian), 998 (others). Must match the build ARG DOCKER_GID.
DOCKER_GID=999

# Stabilization wait time in seconds before running container health checks (Default: 6)
HEALTHCHECK_WAIT_SECONDS=6

# Timeouts (Optional, seconds)
# SSH_TIMEOUT_SECONDS=30
# DOCKER_TIMEOUT_SECONDS=180

# Optional: Path to custom mappings file (YAML or JSON)
# MAPPINGS_FILE=/config/mappings.yaml

# ------------------------------------------------------------------------------
# Remote Node Configuration (Optional - for Multi-Node setups via SSH)
# ------------------------------------------------------------------------------
# If you run services across multiple hosts (e.g. remote VPS or Podman Quadlets)
# REMOTE_SSH_HOST=my-remote-vps
# REMOTE_NODE_NAME=Cloud-VPS
# REMOTE_CONFIGS_DIR=/remote-configs
